{
  "name": "semantic-mermaid",
  "version": "1.0.0",
  "description": "Mermaid flowcharts laid out by what they mean: directives an agent writes in comments, a layout engine that reads them, and a CLI to check and render.",
  "keywords": [
    "mermaid",
    "flowchart",
    "diagram",
    "layout",
    "elk",
    "swimlanes",
    "agents"
  ],
  "author": "Yahor Barkouski",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yahorbarkouski/semantic-mermaid.git"
  },
  "homepage": "https://github.com/yahorbarkouski/semantic-mermaid#readme",
  "bugs": "https://github.com/yahorbarkouski/semantic-mermaid/issues",
  "type": "module",
  "bin": {
    "semantic-mermaid": "toolchain/cli.js"
  },
  "exports": {
    ".": {
      "types": "./types/src/index.d.ts",
      "default": "./src/index.js"
    },
    "./language": {
      "types": "./types/src/language/directives.d.ts",
      "default": "./src/language/directives.js"
    },
    "./check": {
      "types": "./types/toolchain/check.d.ts",
      "default": "./toolchain/check.js"
    },
    "./toolchain": {
      "types": "./types/toolchain/render.d.ts",
      "default": "./toolchain/render.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "toolchain",
    "vendor",
    "types"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check-types": "tsc -p jsconfig.json",
    "types": "tsc -p tsconfig.types.json",
    "prepack": "npm run types",
    "prepublishOnly": "npm run check-types && npm test",
    "images": "node scripts/readme-images.js",
    "vendor": "node scripts/vendor-layout-elk.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "peerDependencies": {
    "mermaid": "^11.0.0 || ^12.0.0"
  },
  "dependencies": {
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@mermaid-js/layout-elk": "1.0.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0",
    "mermaid": "12.1.0"
  }
}
